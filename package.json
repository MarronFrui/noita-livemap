{
  "name": "noita-livemap",
  "version": "1.0.0",
  "description": "A project to merge a few tools from the Noita community",
  "private": true,
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "copy:noitamap": "node scripts/copy-noitamap.mjs",
    "dev": "npm run copy:noitamap && vite",
    "build": "npm run copy:noitamap && vite build",
    "preview": "vite preview",
    "dev:bridge": "cd bridge && npm start",
    "capture:fetch": "node mapgen/pipeline/1-fetch-capture.mjs",
    "gen:server": "node mapgen/server/genmap-server.mjs",
    "gen:clear": "node mapgen/server/gen-cache-clear.mjs",
    "test": "vitest run",
    "re:target": "node scripts/rea-target.mjs",
    "re:check": "node scripts/rea-target.mjs --check",
    "re:doctor": "node scripts/rea-target.mjs && GHIDRA_INSTALL_DIR=${REA_GHIDRA_DIR:-$HOME/tools/ghidra} JAVA_HOME=${REA_JAVA_HOME:-$HOME/tools/jdk} npx -y rea-agents@6.4.0 doctor --provider ghidra --target mapgen/re/target/noita_dev.exe --format md",
    "re:bundle": "node scripts/rea-target.mjs --bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarronFrui/noita-livemap.git"
  },
  "keywords": [
    "noita"
  ],
  "author": "Marron",
  "bugs": {
    "url": "https://github.com/MarronFrui/noita-livemap/issues"
  },
  "homepage": "https://github.com/MarronFrui/noita-livemap#readme",
  "devDependencies": {
    "fengari": "^0.1.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "vite": "^8.0.16",
    "vitest": "^2.1.9"
  }
}
