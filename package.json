{
  "name": "noita-livemap",
  "version": "1.0.0",
  "description": "A project to merge a few tools from the Noita community",
  "private": true,
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "copy:noitamap": "node scripts/copy-noitamap.mjs",
    "dev": "npm run copy:noitamap && vite",
    "build": "npm run copy:noitamap && vite build",
    "preview": "vite preview",
    "dev:bridge": "cd bridge && npm start",
    "bench": "node mapgen/pipeline/2-generate.mjs && node mapgen/pipeline/1-fetch-capture.mjs && node mapgen/pipeline/3-compare.mjs",
    "bench:gen": "node mapgen/pipeline/2-generate.mjs",
    "bench:ref": "node mapgen/pipeline/1-fetch-capture.mjs",
    "bench:diff": "node mapgen/pipeline/3-compare.mjs",
    "test": "node --test \"mapgen/test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarronFrui/noita-livemap.git"
  },
  "keywords": [
    "noita"
  ],
  "author": "Marron",
  "bugs": {
    "url": "https://github.com/MarronFrui/noita-livemap/issues"
  },
  "homepage": "https://github.com/MarronFrui/noita-livemap#readme",
  "devDependencies": {
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "vite": "^8.0.16"
  }
}
